{
  "id": "employment",
  "version": 1,
  "title": "Employment Credential",
  "i18n": {
    "ko": {
      "title": "재직 크리덴셜"
    }
  },
  "label": "stateproof:employment:v1",
  "claims": [
    {
      "key": "employmentStatus",
      "slot": 0,
      "label": "Employment status",
      "type": "enum",
      "operators": [
        "eq",
        "neq",
        "inSet"
      ],
      "i18n": {
        "ko": {
          "label": "재직 상태",
          "values": {
            "Active": "재직 중",
            "Leave": "휴직",
            "Terminated": "퇴사"
          }
        }
      },
      "codes": {
        "Active": 1,
        "Leave": 2,
        "Terminated": 3
      }
    },
    {
      "key": "jobCategory",
      "slot": 1,
      "label": "Job category",
      "type": "enum",
      "operators": [
        "eq",
        "neq",
        "inSet"
      ],
      "i18n": {
        "ko": {
          "label": "직무",
          "values": {
            "Engineering": "엔지니어링",
            "Design": "디자인",
            "Sales": "영업",
            "Operations": "운영",
            "Research": "연구"
          }
        }
      },
      "codes": {
        "Engineering": 1,
        "Design": 2,
        "Sales": 3,
        "Operations": 4,
        "Research": 5
      }
    },
    {
      "key": "employmentStartDate",
      "slot": 2,
      "label": "Employment start date",
      "type": "date",
      "operators": [
        "gte",
        "lte",
        "eq",
        "neq",
        "between"
      ],
      "i18n": {
        "ko": {
          "label": "입사일"
        }
      }
    },
    {
      "key": "employmentMonths",
      "slot": 3,
      "label": "Months employed",
      "type": "integer",
      "unit": "months",
      "operators": [
        "gte"
      ],
      "i18n": {
        "ko": {
          "label": "근속 기간",
          "unit": "개월"
        }
      }
    }
  ]
}
