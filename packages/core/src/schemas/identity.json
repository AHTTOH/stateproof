            "Gyeongbuk": "경북",
            "Gyeongnam": "경남",
            "Jeju": "제주",
            "Gangwon": "강원",
            "Jeonbuk": "전북"
          }
        }
      },
      "codes": {
        "Seoul": 11,
        "Busan": 26,
        "Daegu": 27,
        "Incheon": 28,
        "Gwangju": 29,
        "Daejeon": 30,
