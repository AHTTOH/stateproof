{
  "id": "identity",
  "version": 1,
  "title": "Identity Credential",
  "i18n": {
    "ko": {
      "title": "신원 크리덴셜"
    }
  },
  "label": "stateproof:identity:v1",
  "claims": [
    {
      "key": "birthDate",
      "slot": 0,
      "label": "Date of birth",
      "type": "date",
      "operators": [
        "gte",
        "lte",
        "eq",
        "neq",
        "between"
      ],
      "i18n": {
        "ko": {
          "label": "생년월일"
        }
      }
    },
    {
      "key": "ageYears",
      "slot": 1,
      "label": "Age at issuance",
      "type": "integer",
      "unit": "years",
      "operators": [
        "gte"
      ],
      "i18n": {
        "ko": {
          "label": "발급 시점 나이",
          "unit": "세"
        }
      }
    },
    {
      "key": "nationality",
      "slot": 2,
      "label": "Nationality",
      "type": "enum",
      "operators": [
        "eq",
        "neq",
        "inSet"
      ],
      "i18n": {
        "ko": {
          "label": "국적",
          "values": {
            "KR": "대한민국",
            "US": "미국",
            "JP": "일본",
            "CN": "중국",
            "VN": "베트남"
          }
        }
      },
      "codes": {
        "KR": 410,
        "US": 840,
        "JP": 392,
        "CN": 156,
        "VN": 704
      }
    },
    {
      "key": "region",
      "slot": 3,
      "label": "Region of residence",
      "type": "enum",
      "operators": [
        "eq",
        "neq",
        "inSet"
      ],
      "i18n": {
        "ko": {
          "label": "거주지",
          "values": {
            "Seoul": "서울",
            "Busan": "부산",
            "Daegu": "대구",
            "Incheon": "인천",
            "Gwangju": "광주",
            "Daejeon": "대전",
            "Ulsan": "울산",
            "Sejong": "세종",
            "Gyeonggi": "경기",
            "Chungbuk": "충북",
            "Chungnam": "충남",
