// StateProof shared enums and domain-separation tags.
// Sizes that Compact needs as literals (claim slots = 8, conditions = 4, set values = 4,
// issuer tree depth = 6) live in the struct and ledger definitions and are mirrored by
// packages/core/src/constants.ts. A contract test binds the two together.

export enum Op {
  ignore,
  gte,
  lte,
  eq,
  neq,
  between,
  inSet
}

export pure circuit credentialDomain(): Bytes<32> {
  return pad(32, "stateproof:credential:v2");
}

export pure circuit signatureDomain(): Bytes<32> {
  return pad(32, "stateproof:signature:v2");
}

export pure circuit holderDomain(): Bytes<32> {
  return pad(32, "stateproof:holder:v2");
}

export pure circuit adminDomain(): Bytes<32> {
  return pad(32, "stateproof:admin:v2");
}

export pure circuit issuerLeafDomain(): Bytes<32> {
  return pad(32, "stateproof:issuer-leaf:v2");
}

export pure circuit subjectDomain(): Bytes<32> {
  return pad(32, "stateproof:subject:v2");
}

export pure circuit subjectCommitDomain(): Bytes<32> {
  return pad(32, "stateproof:subject-commit:v2");
}

export pure circuit pseudonymDomain(): Bytes<32> {
  return pad(32, "stateproof:pseudonym:v2");
}
