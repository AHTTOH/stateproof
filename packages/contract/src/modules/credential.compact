// Credential envelope, holder and subject binding, issuer set membership and
// issuer Schnorr signatures over Jubjub.
//
// Signing happens off-chain (packages/core/src/signing): the issuer computes the
// challenge with `signingChallenge` and the scalar `s = k + c * sk mod r_J` in TS,
// where r_J is the Jubjub prime subgroup order. Doing that addition in Compact's
// native Field would reduce mod the BLS12-381 scalar field instead and break the
// verification equation, so the scalar step deliberately stays outside the circuit.
//
// In-circuit hashes use transientHash (Poseidon) to keep browser proving time low.
// Values derived from it are not guaranteed to survive a compiler upgrade that changes
// the hash; docs/decisions/2026-09-30-v2-circuit.md records that trade-off.

export struct Credential {
  schemaId: Bytes<32>,
  issuerId: Bytes<32>,
  // Issuer epoch the credential was issued in. When the issuer rotates its epoch,
  // credentials from earlier epochs stop verifying (revocation without a public list).
  epoch: Uint<32>,
  holderCommit: Field,
  // Hash of the person's normalized name and birth date, set by the issuer.
  // Never disclosed; only compared against a verifier's sealed commitment.
  subjectId: Field,
  claims: Vector<8, Uint<64>>,
  issuedAt: Uint<64>,
  expiresAt: Uint<64>,
  salt: Bytes<32>,
}

export struct Signature {
  r: JubjubPoint,
  s: Field,
}

struct CredentialPreimage {
  domain: Bytes<32>,
  credential: Credential,
}

struct ChallengePreimage {
  domain: Bytes<32>,
  root: Field,
  publicKey: JubjubPoint,
  r: JubjubPoint,
}

struct HolderPreimage {
  domain: Bytes<32>,
  secret: Bytes<32>,
}

struct IssuerLeafPreimage {
  domain: Bytes<32>,
  issuerId: Bytes<32>,
  schemaId: Bytes<32>,
  publicKey: JubjubPoint,
  epoch: Uint<32>,
}

struct SubjectIdPreimage {
  domain: Bytes<32>,
  digest: Bytes<32>,
}

struct SubjectCommitPreimage {
  domain: Bytes<32>,
  subjectId: Field,
  nonce: Bytes<32>,
}

struct PseudonymPreimage {
  domain: Bytes<32>,
  requestId: Bytes<32>,
  secret: Bytes<32>,
}

export pure circuit credentialRoot(credential: Credential): Field {
  return transientHash<CredentialPreimage>(
    CredentialPreimage { domain: credentialDomain(), credential: credential }
  );
}

// The challenge feeds ecMul, whose scalar must lie below r_J (~2^251.8). A raw
// transientHash is a BLS12-381 field element and exceeds r_J most of the time;
// degradeToTransient keeps the low 248 bits, so the result is always < r_J.
export pure circuit signingChallenge(root: Field, publicKey: JubjubPoint, r: JubjubPoint): Field {
  return degradeToTransient(upgradeFromTransient(transientHash<ChallengePreimage>(
    ChallengePreimage { domain: signatureDomain(), root: root, publicKey: publicKey, r: r }
  )));
}

// The holder creates `secret` on their own device and gives the issuer only this commitment.
export pure circuit holderCommitment(secret: Bytes<32>): Field {
  return transientHash<HolderPreimage>(HolderPreimage { domain: holderDomain(), secret: secret });
}

// `digest` is SHA-256 of the normalized "name|YYYYMMDD" string (packages/core/src/subject).
// Issuer and verifier compute it the same way from what each already knows.
export pure circuit subjectIdOf(digest: Bytes<32>): Field {
  return transientHash<SubjectIdPreimage>(SubjectIdPreimage { domain: subjectDomain(), digest: digest });
}

// A verifier seals the expected subject with a random nonce that travels only inside
// the private request link. Without the nonce, the public commitment cannot be tested
// against guessed names.
export pure circuit subjectCommitment(subjectId: Field, nonce: Bytes<32>): Field {
  return transientHash<SubjectCommitPreimage>(
    SubjectCommitPreimage { domain: subjectCommitDomain(), subjectId: subjectId, nonce: nonce }
  );
}

// One pseudonym per (holder, request). The verifier can tell repeat answers apart
// but cannot link the same holder across requests.
export pure circuit pseudonymFor(requestId: Bytes<32>, secret: Bytes<32>): Bytes<32> {
  return upgradeFromTransient(transientHash<PseudonymPreimage>(
    PseudonymPreimage { domain: pseudonymDomain(), requestId: requestId, secret: secret }
  ));
}

export pure circuit issuerLeaf(issuerId: Bytes<32>, schemaId: Bytes<32>, publicKey: JubjubPoint, epoch: Uint<32>): Bytes<32> {
  return upgradeFromTransient(transientHash<IssuerLeafPreimage>(IssuerLeafPreimage {
    domain: issuerLeafDomain(),
    issuerId: issuerId,
    schemaId: schemaId,
    publicKey: publicKey,
    epoch: epoch
  }));
}

export pure circuit derivePublicKey(secretScalar: Field): JubjubPoint {
  return ecMulGenerator(secretScalar);
}

export pure circuit samePoint(a: JubjubPoint, b: JubjubPoint): Boolean {
  return jubjubPointX(a) == jubjubPointX(b) && jubjubPointY(a) == jubjubPointY(b);
}

// Rejects the identity and any point with a torsion component:
// multiplying by (r_J + 1) / 8 and then by the cofactor 8 is the identity map
// only on the prime-order subgroup.
export pure circuit assertUsablePoint(point: JubjubPoint): [] {
  assert(jubjubPointX(point) != 0 || jubjubPointY(point) != 1, "Point must not be the identity");
  const projected = ecMul(
    ecMul(point, 819310549611346726241370945440405716213240158234039660170669895299022906775 as Field),
    8
  );
  assert(samePoint(point, projected), "Point must lie in the prime-order subgroup");
}

export pure circuit isValidSignature(publicKey: JubjubPoint, signature: Signature, challenge: Field): Boolean {
  const left = ecMulGenerator(signature.s);
  const right = ecAdd(signature.r, ecMul(publicKey, challenge));
  return samePoint(left, right);
}
