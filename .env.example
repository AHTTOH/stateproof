# Copy to .env and fill in. Never commit .env. Every value is required by the CLI;
# a missing value stops the command instead of falling back to a default.

# Network key in config/networks.json (preprod | preview).
STATEPROOF_NETWORK=preprod

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Operator wallet seed (hex, 32 bytes). Deploys the contract and pays fees in DUST.
# Fund its unshielded address from the faucet in config/networks.json.
OPERATOR_WALLET_SEED=

# Admin secret (hex, 32 bytes). Its hash is stored on-chain at deploy time; only it can register issuers.
STATEPROOF_ADMIN_SECRET=

# Runtime files, kept outside git. Absolute paths or paths relative to the repo root.
# The first sync of a new wallet on Preprod takes hours; WALLET_STATE_FILE lets later runs resume in seconds.
WALLET_STATE_FILE=
ZK_PARAMS_CACHE_DIR=
PRIVATE_STATE_DIR=
PRIVATE_STATE_PASSWORD=

# Issuer signing keys, written by `npm run issue -w @stateproof/issuer -- keygen --issuer <id>`.
ISSUER_SECRET_ACME_HR=
ISSUER_SECRET_GOV_ID_DEMO=

# Local port for `npm run operator -w @stateproof/cli` (127.0.0.1 only).
OPERATOR_PORT=
