# Copy to .env and fill in. Never commit .env.
# Network key in config/networks.json (preprod | preview).
STATEPROOF_NETWORK=preprod

# Operator wallet seed (hex, 32 bytes) used by packages/cli to deploy and register issuers.
# Fund it from the faucet listed in config/networks.json.
OPERATOR_WALLET_SEED=

# Admin secret (hex, 32 bytes). Its hash is stored on-chain at deploy; only it can register issuers.
STATEPROOF_ADMIN_SECRET=

# Deployed StateProof contract address (filled after `npm run deploy -w @stateproof/cli`).
STATEPROOF_CONTRACT_ADDRESS=
